# Groq LLM Configuration
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# LangSmith Tracing (Optional)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=internship-agent

# Twilio (WhatsApp)
TWILIO_ACCOUNT_SID=AC_your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=
USER_WHATSAPP_NUMBER=

# SendGrid (Email Summaries - Optional)
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
SENDER_EMAIL=your-email@domain.com
RECIPIENT_EMAIL=user@example.com

# Database Connection (PostgreSQL or automatically falls back to SQLite)
DATABASE_URL=
# Candidate Profile (used for auto-filling job application forms)
CANDIDATE_NAME=
CANDIDATE_EMAIL=
CANDIDATE_PHONE=
CANDIDATE_GITHUB=
CANDIDATE_LINKEDIN=

# Agent Thresholds & Sources
MATCH_SCORE_THRESHOLD=50
APPROVAL_TIMEOUT_HOURS=24
AUTO_REJECT_ON_TIMEOUT=true
JOB_SOURCES=arbeitnow,remotive,himalayas,adzuna

# Adzuna API Keys (Optional - Free up to 250 req/day at https://developer.adzuna.com/)
ADZUNA_APP_ID=
ADZUNA_API_KEY=

# Debug Logging Flag
DEBUG=false
