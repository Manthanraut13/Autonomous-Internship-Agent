# Groq LLM Configuration
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# LangSmith Tracing (Optional)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=internship-agent

# Web Search portal (Main #3) — provide ONE of the two options; without either,
# the Web Search portal honestly returns nothing (logged once per run).
# Option A — Google Programmable Search (official Google, free 100 queries/day):
#   1. https://programmablesearchengine.google.com/  -> create engine ("Search the entire web")
#   2. Google Cloud console -> create API key
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
# Option B — Brave Search API (free 2,000 queries/month): https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=

# Twilio (WhatsApp)
TWILIO_ACCOUNT_SID=AC_your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=
USER_WHATSAPP_NUMBER=

# Email Delivery Option 1: Gmail SMTP App Password (Recommended - never expires)
# Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_google_app_password
RECIPIENT_EMAIL=your_email@gmail.com

# Email Delivery Option 2: SendGrid (Requires verified Single Sender email)
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
SENDER_EMAIL=your_verified_sender@domain.com


# Database Connection (PostgreSQL REQUIRED — no SQLite fallback in production)
# Use the External PostgreSQL URL from Supabase or Render
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
# Candidate Profile (used for auto-filling job application forms)
CANDIDATE_NAME=
CANDIDATE_EMAIL=
CANDIDATE_PHONE=
CANDIDATE_GITHUB=
CANDIDATE_LINKEDIN=

# Agent Thresholds & Sources
MATCH_SCORE_THRESHOLD=50
APPROVAL_TIMEOUT_HOURS=24
AUTO_REJECT_ON_TIMEOUT=true
JOB_SOURCES=yc,startupjobs,websearch,wellfound,cutshort,linkedin,instahyre,hirist,naukri,hn,remoteok,remotive,himalayas,wwr,builtin,wttj,underdog,nodesk,remoterocketship,interndoor,jobsii,greenhouse,lever,ashby,workable,discovery

# Dashboard Security & Authentication (ALL REQUIRED — no insecure defaults)
# Generate AUTH_SECRET_KEY: python -c "import secrets; print(secrets.token_hex(32))"
# ADMIN_PASSWORD must be ≥12 chars with uppercase + lowercase + digit
ADMIN_USERNAME=your_unique_admin_username
ADMIN_PASSWORD=YourStrong@Password1
AUTH_SECRET_KEY=generate_a_64_char_hex_secret_with_secrets_token_hex_32

# CORS Allowed Origins (comma-separated; leave empty for same-origin only)
# Example: https://your-app.onrender.com,http://localhost:5173
CORS_ALLOWED_ORIGINS=

# Debug Logging Flag
DEBUG=false

# Scheduler Control (set to 'true' on Render to disable in-process APScheduler)
# When disabled, GitHub Actions handles the 9AM/9PM pipeline scheduling externally
DISABLE_SCHEDULER=false
